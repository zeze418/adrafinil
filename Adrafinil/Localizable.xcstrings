    },
    "How to trust" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何信任"
          }
        }
      }
    },
    "Idle agents" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空闲的智能体"
          }
        }
      }
    },
    "If an agent does nothing for a while, Adrafinil stops keeping your Mac awake for it — so a stuck or crashed agent can't hold it up forever." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果智能体一段时间内没有任何活动，Adrafinil 就会停止为它保持 Mac 唤醒——这样卡住或崩溃的智能体就不会让 Mac 永远无法睡眠。"
          }
        }
      }
    },
    "In-place updating is disabled in development builds." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发版本已禁用就地更新。"
