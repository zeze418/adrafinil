    "Couldn't download the update. Check your connection, or get it from the releases page." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法下载更新。请检查网络连接，或前往发布页面获取。"
          }
