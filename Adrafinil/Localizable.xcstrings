      }
    },
    "Couldn't load the release notes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载发布说明。"
          }
        }
      }
    },
    "Couldn't reach Adrafinil's background helper." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 Adrafinil 的后台助手。"
          }
        }
      }
    },
    "Couldn't repair Adrafinil automatically" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法自动修复 Adrafinil"
          }
        }
      }
    },
    "Custom agents aren't auto-detected or watched, so pair every acquire with a reliable release — the idle-release timeout and each hold's time limit are the only safety net if one is missed. Snippets assume the %@ command is on your PATH (%@, or %@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom agents aren't auto-detected or watched, so pair every acquire with a reliable release — the idle-release timeout and each hold's time limit are the only safety net if one is missed. Snippets assume the %1$@ command is on your PATH (%2$@, or %3$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义智能体不会被自动检测或监视，因此每个 acquire 都要配一个可靠的 release——一旦漏掉，空闲释放超时和每次保持的时间上限就是仅有的安全网。代码片段假定 %1$@ 命令在你的 PATH 中（%2$@ 或 %3$@）。"
          }
        }
      }
    },
    "Custom duration" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义时长"
          }
        }
      }
    },
    "Disconnects Adrafinil from every agent, turns off its background services, removes the adrafinil command, and deletes its settings — then quits." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开 Adrafinil 与所有智能体的连接，关闭其后台服务，移除 adrafinil 命令并删除其设置——然后退出。"
          }
        }
      }
    },
