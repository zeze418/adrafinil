{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    " (it peaked at %lld°C)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（最高达到 %lld°C）"
          }
        }
      }
    },
    "$SESSION_ID" : {},
    "%@ [Releases page.](https://github.com/kageroumado/adrafinil/releases)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ [前往发布页面。](https://github.com/kageroumado/adrafinil/releases)"
          }
        }
      }
    },
    "%@ may not be tracked" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能无法追踪 %@"
          }
        }
      }
    },
    "%@'s Adrafinil hook isn't in the form Adrafinil expects — likely edited by hand or left over from an update — so it may not notice when %@ is working and keep your Mac awake. Reconnect restores it without touching your other %@ settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@'s Adrafinil hook isn't in the form Adrafinil expects — likely edited by hand or left over from an update — so it may not notice when %2$@ is working and keep your Mac awake. Reconnect restores it without touching your other %3$@ settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中的 Adrafinil 钩子与预期格式不一致——可能被手动改过，或是更新后残留的旧版本——因此它可能察觉不到 %2$@ 正在工作，也就无法让 Mac 保持唤醒。“重新连接”会恢复它，且不会改动你在 %3$@ 中的其他设置。"
          }
        }
      }
    },
    "%@'s settings file couldn't be read (it may contain comments or a syntax error). Adrafinil won't modify it in this state — fix the file, then try connecting again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@ 的设置文件（其中可能有注释或语法错误）。在这种状态下 Adrafinil 不会修改它——请先修复该文件，再尝试连接。"
          }
        }
      }
    },
    "%@." : {
      "comment" : "The agent tally, closed as a sentence",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。"
          }
        }
      }
    },
